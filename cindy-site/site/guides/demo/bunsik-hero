<script>
  /* ---------- marquee content ---------- */
  const items = "WAGYU SMASH ★ KOREAN FRIED CHICKEN ★ 분식 ★ CHEESE PULL HOTDOGS ★ TTEOKBOKKI HEAT ★ SEOUL STREET FOOD ★ ";
  document.getElementById('marqueeTrack').textContent = items + items;

  /* ---------- scroll-driven video ---------- */
  const video = document.getElementById('heroVideo');
  const scrolly = document.querySelector('.scrolly');
  const heroCopy = document.getElementById('heroCopy');
  const heroEnd = document.getElementById('heroEnd');
  const scrollHint = document.getElementById('scrollHint');

  let target = 0, shown = 0;

  function readScroll() {
    const total = scrolly.offsetHeight - innerHeight;
    const y = -scrolly.getBoundingClientRect().top;
    target = Math.min(1, Math.max(0, y / total));
  }
  addEventListener('scroll', readScroll, { passive: true });
  addEventListener('resize', readScroll);
  readScroll();

  function tick() {
    requestAnimationFrame(tick);
    shown += (target - shown) * 0.09;
    if (video.duration && !video.seeking) {
      const t = shown * (video.duration - 0.05);
      if (Math.abs(t - video.currentTime) > 0.004) video.currentTime = t;
    }
    // headline retreats as the scrub begins
    const c = Math.max(0, 1 - shown * 2.6);
    heroCopy.style.opacity = c;
    heroCopy.style.transform = `translateY(${shown * -70}px) scale(${1 - shown * .08})`;
    // closing line rises near the end of the shot
    heroEnd.style.opacity = Math.min(1, Math.max(0, (shown - 0.78) * 5));
    scrollHint.style.opacity = Math.max(0, 1 - shown * 6);
  }
  requestAnimationFrame(tick);

  /* ---------- reveal on scroll ---------- */
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
</script>

