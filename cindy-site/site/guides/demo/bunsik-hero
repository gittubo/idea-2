  .btn-ghost {
    display: inline-block;
    font-family: var(--display); font-size: 15px; letter-spacing: .04em;
    border: 2px solid rgba(250,243,227,.4); color: var(--cream);
    padding: 11px 26px; border-radius: 999px;
