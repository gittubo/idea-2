    --yellow: #F7B500;
    --yellow-deep: #E8A400;
    --ink: #0C0C0C;
    --ink-soft: #161616;
    --cream: #FAF3E3;
    --red: #E4572E;
    --display: "Black Han Sans", sans-serif;
