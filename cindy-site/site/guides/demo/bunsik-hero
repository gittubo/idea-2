  }
  .hero-copy {
    position: absolute; inset: 0; z-index: 5;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    text-align: center; padding: 15vh 24px 0;
    pointer-events: none;
  }
  .hero-copy .kicker {
    font-weight: 700; font-size: 13px; letter-spacing: .34em; text-transform: uppercase;
    color: var(--yellow);
    background: rgba(12,12,12,.55); padding: 8px 16px; border-radius: 999px;
    margin-bottom: 18px;
  }
  .hero-copy h1 {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(28px, 6.15vw, 94px);
    line-height: 1; letter-spacing: 0;
    white-space: nowrap;
    color: #fff;
    text-shadow: 0 8px 50px rgba(0,0,0,.55);
  }
  .hero-copy h1 .yellow { color: var(--yellow); }
  .hero-copy p {
    position: absolute; bottom: 78px; left: 50%; transform: translateX(-50%);
    white-space: nowrap;
    font-size: clamp(13px, 1.5vw, 18px); font-weight: 500;
    color: rgba(250,243,227,.92);
    background: rgba(12,12,12,.5); padding: 10px 18px; border-radius: 999px;
  }
  .hero-end {
    position: absolute; inset: 0; z-index: 6;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
    padding-bottom: 12vh; text-align: center;
    opacity: 0; pointer-events: none;
  }
  .hero-end h2 {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(34px, 5vw, 72px); color: #fff;
    text-shadow: 0 6px 30px rgba(0,0,0,.5);
    margin-bottom: 22px;
  }
  .hero-end .btn { pointer-events: auto; font-size: 18px; padding: 16px 34px; }
  .scroll-hint {
    position: absolute; bottom: 26px; left: 50%; transform: translateX(-50%);
    z-index: 7; display: flex; align-items: center; gap: 10px;
    font-size: 12px; font-weight: 600; letter-spacing: .28em; text-transform: uppercase;
    color: rgba(250,243,227,.8);
  }
  .scroll-hint .wheel {
    width: 22px; height: 34px; border: 2px solid rgba(250,243,227,.8); border-radius: 12px;
    position: relative;
  }
  .scroll-hint .wheel::after {
    content: ""; position: absolute; left: 50%; top: 6px; transform: translateX(-50%);
    width: 4px; height: 7px; border-radius: 3px; background: var(--yellow);
    animation: wheel 1.6s infinite;
  }
  @keyframes wheel { 0% {top: 6px; opacity: 1;} 70% {top: 18px; opacity: 0;} 100% {top: 6px; opacity: 0;} }

  /* ---------- marquee ---------- */
  .marquee {
    background: var(--yellow); color: var(--ink);
    overflow: hidden; white-space: nowrap;
    padding: 16px 0;
    transform: rotate(-1.2deg) scale(1.02);
    border-top: 3px solid var(--ink); border-bottom: 3px solid var(--ink);
    position: relative; z-index: 10;
  }
  .marquee .track {
    display: inline-block;
    font-family: var(--display); font-size: 26px; letter-spacing: .03em;
    animation: marquee 26s linear infinite;
  }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ---------- sections ---------- */
  section { position: relative; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
  .sec-head {
    display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap;
    margin-bottom: 42px;
  }
  .sec-head h2 {
