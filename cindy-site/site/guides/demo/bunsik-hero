    font-size: clamp(44px, 6vw, 84px); line-height: 1;
  }
  .sec-head .hangul {
    font-family: var(--display); font-size: clamp(22px, 2.6vw, 34px);
    opacity: .45;
  }

  /* greatest hits */
  .hits { background: var(--cream); color: var(--ink); padding: 96px 0 110px; }
  .hits .sec-head h2 .accent { color: var(--red); }
  .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .card {
    background: var(--ink); color: var(--cream);
