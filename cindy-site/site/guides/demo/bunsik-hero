    font-family: var(--display); font-size: 110px; opacity: .08; line-height: 1;
    pointer-events: none;
  }
  .card .tag {
    position: absolute; top: 20px; right: 18px;
    font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    background: var(--red); color: #fff;
    padding: 5px 10px; border-radius: 999px;
    transform: rotate(3deg);
  }
  .card:nth-child(2n) .tag { background: var(--ink); color: var(--yellow); }

  /* menu */
  .menu { background: var(--ink); padding: 100px 0 110px; }
  .menu .sec-head h2 { color: var(--yellow); }
  .menu-cols { columns: 3; column-gap: 34px; }
  .mcat { break-inside: avoid; margin-bottom: 40px; }
  .mcat h3 {
